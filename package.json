{
  "name": "parin-mindmap",
  "version": "0.1.0",
  "description": "Parin MindMap — a professional, multilingual, AI-ready mind mapping desktop application.",
  "main": "electron/main.cjs",
  "author": "Parin.M",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win7": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.parin.mindmap",
    "productName": "Parin MindMap",
    "artifactName": "Parin-MindMap-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Parin-MindMap-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parin MindMap",
      "runAfterFinish": true,
      "installerLanguages": "en_US",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "runtime/llama/llama-server.exe",
        "to": "ai/llama-server.exe"
      },
      {
        "from": "runtime/models/Gemma3-1B-FP16-bnb-4bit-Q4_K_M.gguf",
        "to": "ai/models/Gemma3-1B-FP16-bnb-4bit-Q4_K_M.gguf"
      },
      {
        "from": "runtime/models/harrier-oss-v1-0.6b.Q4_K_M.gguf",
        "to": "ai/models/harrier-oss-v1-0.6b.Q4_K_M.gguf"
      },
      {
        "from": "runtime/ai-notice.txt",
        "to": "ai/ai-notice.txt"
      }
    ]
  }
}
